# Export these values explicitly before invoking pnpm; .env is not auto-loaded.
DATABASE_URL=postgres://patternpilot:local-development-only@127.0.0.1:5432/patternpilot
# Dedicated database only. Migration tests need a local test role with CREATEDB.
TEST_DATABASE_URL=postgres://patternpilot:local-development-only@127.0.0.1:5432/patternpilot_test
# API process:
PORT=5000
# Frontend uses its own PORT=5173 and BASE_PATH=/.
# Optional Vite development proxy target:
API_PROXY_TARGET=http://127.0.0.1:5000

# Required for all /api/admin/* requests. Unset means admin access is disabled.
# Supply a long random value on the API process only; never use a VITE_ variable.
# Send it as Authorization: Bearer <ADMIN_SECRET>.
ADMIN_SECRET=
